{
  "manifest_version": 3,
  "name": "LISTNR — Listener",
  "short_name": "LISTNR",
  "version": "0.1.0",
  "description": "Turn any page into audio. Natural pauses, speed control, sentence highlighting, and an optional studio voice.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "offscreen",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Read with LISTNR",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle": {
      "suggested_key": { "default": "Alt+Shift+P", "mac": "Alt+Shift+P" },
      "description": "Read or pause"
    },
    "next": {
      "suggested_key": { "default": "Alt+Shift+N", "mac": "Alt+Shift+N" },
      "description": "Next sentence"
    },
    "prev": {
      "suggested_key": { "default": "Alt+Shift+B", "mac": "Alt+Shift+B" },
      "description": "Previous sentence"
    },
    "close": {
      "suggested_key": { "default": "Alt+Shift+X", "mac": "Alt+Shift+X" },
      "description": "Close the LISTNR reader"
    }
  }
}
